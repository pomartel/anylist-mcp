{
  "name": "anylist-mcp",
  "version": "1.8.0",
  "description": "MCP server for AnyList shopping list integration",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:client": "node test/anylist-client/index.js",
    "test:integration": "node test/integration.js",
    "pack": "mcpb pack",
    "start:http": "node src/http/index.js",
    "dev:http": "node --watch src/http/index.js",
    "test": "node --test test/*.test.js test/tools/*.test.js",
    "release": "semantic-release"
  },
  "keywords": [
    "mcp",
    "anylist",
    "shopping",
    "list"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "anylist": "file:vendor/anylist-0.8.6.tgz",
    "bcrypt": "6.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "semantic-release": "25.0.9",
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "proxy-addr": "2.0.8",
    "follow-redirects": "1.16.1",
    "qs": "6.16.1",
    "brace-expansion": "5.0.12"
  }
}
